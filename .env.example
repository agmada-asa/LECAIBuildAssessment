# OpenAI-compatible candidate analysis and embeddings. These values stay on the
# server. The app does not provide a local embedding runtime or fallback.
OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
OPENAI_COMPATIBLE_API_KEY=replace-with-a-server-only-key
OPENAI_COMPATIBLE_ANALYSIS_MODEL=replace-with-an-analysis-model

# Use a model identifier and immutable revision verified by the embedding benchmark.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_ROLLOUT_MODE=shadow
OPENAI_COMPATIBLE_EMBEDDING_MODEL=replace-with-a-pinned-model-identifier
OPENAI_COMPATIBLE_EMBEDDING_REVISION=replace-with-an-immutable-revision
OPENAI_COMPATIBLE_EMBEDDING_DIMENSIONS=1536
OPENAI_COMPATIBLE_EMBEDDING_MAX_INPUT_TOKENS=8192
OPENAI_COMPATIBLE_EMBEDDING_MAX_INPUT_CHARACTERS=24000
OPENAI_COMPATIBLE_EMBEDDING_MAX_BATCH_SIZE=64
EMBEDDING_TIMEOUT_MS=15000
EMBEDDING_MAX_RETRIES=2

# Optional SQLite location. Defaults to data/resolve.sqlite in the project.
SQLITE_DATABASE_PATH=data/resolve.sqlite
